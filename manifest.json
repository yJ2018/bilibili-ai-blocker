{
  "manifest_version": 3,
  "name": "B站 AI 内容屏蔽",
  "version": "1.7.2",
  "description": "自动识别并隐藏 B 站中带有「含AI生成内容」标注的视频卡片，支持首页、搜索页、视频页推荐等。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "B站 AI 内容屏蔽",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
